# Copy to .env, fill in real values, then `set -a; . ./.env; set +a` before running
# commands — a repo-root .env is NOT auto-read by `docker compose -f`. Dev defaults
# are baked into compose/scripts, so local dev needs none of this.
POSTGRES_USER=jmea_admin
POSTGRES_PASSWORD=jmea_dev_admin
POSTGRES_DB=jmea
POSTGRES_PORT=5433
APP_PORTAL_PASSWORD=portal_dev
TRANSFORM_PASSWORD=transform_dev
SVC_ANALYTICS_PASSWORD=analytics_dev
SVC_MATCHING_PASSWORD=matching_dev
JMEA_DB_HOST=localhost
JMEA_DB_PORT=5433
JMEA_DB_NAME=jmea
JMEA_DB_ADMIN_USER=jmea_admin
JMEA_DB_ADMIN_PASSWORD=jmea_dev_admin

# --- Lightdash (analytics layer) ---
LIGHTDASH_PG_PASSWORD=lightdash_dev
LIGHTDASH_SECRET=jmea_dev_lightdash_secret
LIGHTDASH_PORT=8080
LIGHTDASH_SITE_URL=http://localhost:8080
# S3-compatible object storage (self-hosted MinIO) — required by Lightdash to boot
MINIO_ROOT_USER=lightdash_dev
MINIO_ROOT_PASSWORD=lightdash_dev_minio_pw
MINIO_PORT=9000
LIGHTDASH_S3_BUCKET=lightdash
LIGHTDASH_S3_REGION=us-east-1
# Set after one-time bootstrap (see README): personal access token + project UUID
LIGHTDASH_URL=http://localhost:8080
LIGHTDASH_PAT=
LIGHTDASH_PROJECT=
